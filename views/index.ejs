<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= data.event.name %> <%= data.event.nameShort %> — <%= data.event.organizer %></title>
<meta name="description" content="Thiệp mời <%= data.event.name %> <%= data.event.nameShort %> của <%= data.event.organizer %>">
<meta property="og:title" content="<%= data.event.name %> <%= data.event.nameShort %>">
<meta property="og:description" content="<%= data.event.dateDisplay %> · <%= data.event.time %> · <%= data.event.location %>">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/style.css?v=<%= typeof cssVersion !== 'undefined' ? cssVersion : Date.now() %>">
</head>
<body>

<!-- ============ MÀN HÌNH MỞ THIỆP: CỔNG RỪNG (vẽ bằng code) ============ -->
<div id="opening">
  <!-- ===== Nền trời + rừng nhiều lớp ===== -->
  <div class="scene">
    <div class="sky"></div>
    <div class="sun-glow"></div>

    <!-- Cây rừng lớp xa -->
    <div class="trees trees-far">
      <svg viewBox="0 0 1200 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="#0c2b1c">
          <path d="M40,400 L60,180 Q40,170 60,150 Q80,170 60,140 Q90,150 70,120 L70,400 Z"/>
          <path d="M180,400 L200,140 Q180,130 200,110 Q220,130 200,90 Q230,100 210,70 L210,400 Z"/>
          <path d="M330,400 L350,200 Q330,190 350,170 Q370,190 350,150 Q380,160 360,130 L360,400 Z"/>
          <path d="M470,400 L490,120 Q470,110 490,90 Q510,110 490,70 Q520,80 500,50 L500,400 Z"/>
          <path d="M620,400 L640,170 Q620,160 640,140 Q660,160 640,120 Q670,130 650,100 L650,400 Z"/>
          <path d="M760,400 L780,150 Q760,140 780,120 Q800,140 780,100 Q810,110 790,80 L790,400 Z"/>
          <path d="M900,400 L920,190 Q900,180 920,160 Q940,180 920,140 Q950,150 930,120 L930,400 Z"/>
          <path d="M1040,400 L1060,160 Q1040,150 1060,130 Q1080,150 1060,110 Q1090,120 1070,90 L1070,400 Z"/>
          <path d="M1160,400 L1180,210 Q1160,200 1180,180 Q1200,200 1180,160 L1180,400 Z"/>
        </g>
      </svg>
    </div>

    <!-- Cây rừng lớp gần -->
    <div class="trees trees-near">
      <svg viewBox="0 0 1200 460" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="#082016">
          <path d="M0,460 L0,120 Q30,100 20,60 Q60,90 50,40 Q90,70 80,20 L100,460 Z"/>
          <path d="M1200,460 L1200,120 Q1170,100 1180,60 Q1140,90 1150,40 Q1110,70 1120,20 L1100,460 Z"/>
          <path d="M250,460 L265,240 Q250,230 265,210 Q280,230 265,190 L265,460 Z"/>
          <path d="M950,460 L935,240 Q950,230 935,210 Q920,230 935,190 L935,460 Z"/>
        </g>
      </svg>
    </div>

    <!-- Lá cây rủ từ trên xuống -->
    <div class="canopy canopy-left">
      <svg viewBox="0 0 300 220" preserveAspectRatio="xMinYMin" aria-hidden="true">
        <g fill="#123a26" opacity=".95">
          <path d="M0,0 L300,0 Q260,30 200,40 Q150,50 120,90 Q80,140 40,150 Q15,155 0,140 Z"/>
          <ellipse cx="80" cy="70" rx="45" ry="30" transform="rotate(20 80 70)"/>
          <ellipse cx="180" cy="50" rx="50" ry="32" transform="rotate(-12 180 50)"/>
          <ellipse cx="120" cy="110" rx="40" ry="26" transform="rotate(35 120 110)"/>
        </g>
      </svg>
    </div>
    <div class="canopy canopy-right">
      <svg viewBox="0 0 300 220" preserveAspectRatio="xMaxYMin" aria-hidden="true">
        <g fill="#123a26" opacity=".95">
          <path d="M300,0 L0,0 Q40,30 100,40 Q150,50 180,90 Q220,140 260,150 Q285,155 300,140 Z"/>
          <ellipse cx="220" cy="70" rx="45" ry="30" transform="rotate(-20 220 70)"/>
          <ellipse cx="120" cy="50" rx="50" ry="32" transform="rotate(12 120 50)"/>
          <ellipse cx="180" cy="110" rx="40" ry="26" transform="rotate(-35 180 110)"/>
        </g>
      </svg>
    </div>

    <!-- Ánh sáng xuyên tán lá -->
    <div class="god-rays"></div>
    <!-- Sương mù -->
    <div class="mist"></div>

    <!-- Lá bay + đom đóm -->
    <div class="leaves" aria-hidden="true"></div>
    <div class="fireflies" aria-hidden="true"></div>
  </div>

  <!-- ===== Sàn gạch lát (vẽ SVG phối cảnh) ===== -->
  <div class="floor">
    <svg viewBox="0 0 1200 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="floorGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#1c3226"/>
          <stop offset="0.5" stop-color="#243b2c"/>
          <stop offset="1" stop-color="#16281d"/>
        </linearGradient>
        <linearGradient id="floorFade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#04120b" stop-opacity="0.95"/>
          <stop offset="0.35" stop-color="#04120b" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <rect width="1200" height="300" fill="url(#floorGrad)"/>
      <!-- Đường lát gạch hội tụ về tâm -->
      <g stroke="#3a5644" stroke-width="1.6" opacity="0.55">
        <line x1="600" y1="0" x2="-100" y2="300"/>
        <line x1="600" y1="0" x2="120" y2="300"/>
        <line x1="600" y1="0" x2="340" y2="300"/>
        <line x1="600" y1="0" x2="520" y2="300"/>
        <line x1="600" y1="0" x2="680" y2="300"/>
        <line x1="600" y1="0" x2="860" y2="300"/>
        <line x1="600" y1="0" x2="1080" y2="300"/>
        <line x1="600" y1="0" x2="1300" y2="300"/>
      </g>
      <!-- Đường ngang gạch -->
      <g stroke="#3a5644" stroke-width="1.4" opacity="0.45">
        <line x1="0" y1="60" x2="1200" y2="60"/>
        <line x1="0" y1="120" x2="1200" y2="120"/>
        <line x1="0" y1="190" x2="1200" y2="190"/>
        <line x1="0" y1="260" x2="1200" y2="260"/>
      </g>
      <rect width="1200" height="300" fill="url(#floorFade)"/>
    </svg>
  </div>

  <!-- ===== CỔNG (SVG vẽ chi tiết) ===== -->
  <div class="gate3d" id="gate3d" title="Chạm để mở thiệp" role="button" tabindex="0" aria-label="Mở thiệp">
    <svg class="gate-svg" viewBox="0 0 420 580" preserveAspectRatio="xMidYMax meet" aria-hidden="true">
      <defs>
        <linearGradient id="gStone" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0" stop-color="#5c7a63"/>
          <stop offset="0.35" stop-color="#7a967d"/>
          <stop offset="0.6" stop-color="#8aa588"/>
          <stop offset="1" stop-color="#4f6b55"/>
        </linearGradient>
        <linearGradient id="gStoneTop" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#93ad8f"/>
          <stop offset="1" stop-color="#5f7d63"/>
        </linearGradient>
        <linearGradient id="gVine" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#5aa06e"/>
          <stop offset="1" stop-color="#2f6e46"/>
        </linearGradient>
        <radialGradient id="gInner" cx="50%" cy="42%" r="65%">
          <stop offset="0" stop-color="#2a4a32"/>
          <stop offset="0.6" stop-color="#16301f"/>
          <stop offset="1" stop-color="#08160e"/>
        </radialGradient>
        <linearGradient id="gGold" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f5e9c8"/>
          <stop offset="1" stop-color="#c9a227"/>
        </linearGradient>
        <!-- Bóng đổ mềm -->
        <radialGradient id="gShadow" cx="50%" cy="50%" r="50%">
          <stop offset="0" stop-color="#020a05" stop-opacity="0.55"/>
          <stop offset="1" stop-color="#020a05" stop-opacity="0"/>
        </radialGradient>
      </defs>

      <!-- Bóng đổ mặt đất -->
      <ellipse cx="210" cy="566" rx="200" ry="26" fill="url(#gShadow)"/>

      <!-- === THÂN CỔNG: trụ + vòm === -->
      <!-- Khối đá nền (sáng hơn) -->
      <path d="M28,580 L28,215 Q28,60 210,60 Q392,60 392,215 L392,580 L44,580 L44,222 Q44,76 210,76 Q376,76 376,222 L376,580 Z"
            fill="url(#gStone)" stroke="#3a5340" stroke-width="2"/>
      <!-- Đỉnh vòm sáng (highlight) -->
      <path d="M44,222 Q44,76 210,76 Q376,76 376,222" fill="none" stroke="url(#gStoneTop)" stroke-width="8" opacity="0.9"/>

      <!-- Vân đá trụ trái -->
      <g stroke="#415a47" stroke-width="1.2" opacity="0.55" fill="none">
        <line x1="30" y1="269.0" x2="80" y2="269.0"/><line x1="30" y1="303.0" x2="80" y2="303.0"/><line x1="30" y1="337.0" x2="80" y2="337.0"/><line x1="30" y1="371.0" x2="80" y2="371.0"/><line x1="30" y1="405.0" x2="80" y2="405.0"/><line x1="30" y1="439.0" x2="80" y2="439.0"/><line x1="30" y1="473.0" x2="80" y2="473.0"/><line x1="30" y1="507.0" x2="80" y2="507.0"/><line x1="30" y1="541.0" x2="80" y2="541.0"/><line x1="55.0" y1="235.0" x2="55.0" y2="269.0"/><line x1="42.5" y1="269.0" x2="42.5" y2="303.0"/><line x1="67.5" y1="269.0" x2="67.5" y2="303.0"/><line x1="55.0" y1="303.0" x2="55.0" y2="337.0"/><line x1="42.5" y1="337.0" x2="42.5" y2="371.0"/><line x1="67.5" y1="337.0" x2="67.5" y2="371.0"/><line x1="55.0" y1="371.0" x2="55.0" y2="405.0"/><line x1="42.5" y1="405.0" x2="42.5" y2="439.0"/><line x1="67.5" y1="405.0" x2="67.5" y2="439.0"/><line x1="55.0" y1="439.0" x2="55.0" y2="473.0"/><line x1="42.5" y1="473.0" x2="42.5" y2="507.0"/><line x1="67.5" y1="473.0" x2="67.5" y2="507.0"/><line x1="55.0" y1="507.0" x2="55.0" y2="541.0"/><line x1="42.5" y1="541.0" x2="42.5" y2="575.0"/><line x1="67.5" y1="541.0" x2="67.5" y2="575.0"/>
      </g>
      <!-- Vân đá trụ phải -->
      <g stroke="#415a47" stroke-width="1.2" opacity="0.55" fill="none">
        <line x1="340" y1="269.0" x2="390" y2="269.0"/><line x1="340" y1="303.0" x2="390" y2="303.0"/><line x1="340" y1="337.0" x2="390" y2="337.0"/><line x1="340" y1="371.0" x2="390" y2="371.0"/><line x1="340" y1="405.0" x2="390" y2="405.0"/><line x1="340" y1="439.0" x2="390" y2="439.0"/><line x1="340" y1="473.0" x2="390" y2="473.0"/><line x1="340" y1="507.0" x2="390" y2="507.0"/><line x1="340" y1="541.0" x2="390" y2="541.0"/><line x1="365.0" y1="235.0" x2="365.0" y2="269.0"/><line x1="352.5" y1="269.0" x2="352.5" y2="303.0"/><line x1="377.5" y1="269.0" x2="377.5" y2="303.0"/><line x1="365.0" y1="303.0" x2="365.0" y2="337.0"/><line x1="352.5" y1="337.0" x2="352.5" y2="371.0"/><line x1="377.5" y1="337.0" x2="377.5" y2="371.0"/><line x1="365.0" y1="371.0" x2="365.0" y2="405.0"/><line x1="352.5" y1="405.0" x2="352.5" y2="439.0"/><line x1="377.5" y1="405.0" x2="377.5" y2="439.0"/><line x1="365.0" y1="439.0" x2="365.0" y2="473.0"/><line x1="352.5" y1="473.0" x2="352.5" y2="507.0"/><line x1="377.5" y1="473.0" x2="377.5" y2="507.0"/><line x1="365.0" y1="507.0" x2="365.0" y2="541.0"/><line x1="352.5" y1="541.0" x2="352.5" y2="575.0"/><line x1="377.5" y1="541.0" x2="377.5" y2="575.0"/>
      </g>

      <!-- === Khoảng tối bên trong cổng === -->
      <path d="M82,580 L82,222 Q82,112 210,112 Q338,112 338,222 L338,580 Z" fill="url(#gInner)"/>

      <!-- Viền vòm vàng trang trí trong -->
      <path d="M86,222 Q86,118 210,118 Q334,118 334,222" stroke="url(#gGold)" stroke-width="3.5" fill="none" opacity="0.85"/>
      <path d="M96,222 Q96,128 210,128 Q324,128 324,222" stroke="rgba(232,212,139,.3)" stroke-width="2" fill="none"/>

      <!-- === Đá chóp trụ (đế + đỉnh) === -->
      <rect x="24" y="210" width="12" height="360" fill="#6b8670" opacity="0.6"/>
      <rect x="384" y="210" width="12" height="360" fill="#5a7560" opacity="0.6"/>
      <!-- Đế chân trụ -->
      <rect x="22" y="556" width="60" height="26" rx="3" fill="#4f6b55" stroke="#3a5340" stroke-width="1.5"/>
      <rect x="338" y="556" width="60" height="26" rx="3" fill="#4f6b55" stroke="#3a5340" stroke-width="1.5"/>
      <!-- Đinh đá trên đế -->
      <g fill="#3a5340" opacity="0.6">
        <circle cx="34" cy="569" r="2.5"/><circle cx="52" cy="569" r="2.5"/><circle cx="70" cy="569" r="2.5"/>
        <circle cx="350" cy="569" r="2.5"/><circle cx="368" cy="569" r="2.5"/><circle cx="386" cy="569" r="2.5"/>
      </g>

      <!-- === Rêu bám trên đá === -->
      <g fill="#3f7d57" opacity="0.55">
        <ellipse cx="40" cy="540" rx="14" ry="8"/>
        <ellipse cx="54" cy="500" rx="10" ry="6"/>
        <ellipse cx="36" cy="300" rx="8" ry="10"/>
        <ellipse cx="380" cy="530" rx="13" ry="8"/>
        <ellipse cx="366" cy="480" rx="9" ry="6"/>
        <ellipse cx="384" cy="320" rx="7" ry="9"/>
        <ellipse cx="120" cy="90" rx="12" ry="7"/>
        <ellipse cx="300" cy="88" rx="11" ry="7"/>
      </g>

      <!-- === Dây leo bám cổng === -->
      <path d="M38,580 Q22,430 56,330 Q84,248 68,166 Q60,124 98,100" stroke="url(#gVine)" stroke-width="6.5" fill="none" stroke-linecap="round"/>
      <path d="M382,580 Q398,430 364,320 Q336,238 354,156 Q368,114 334,92" stroke="url(#gVine)" stroke-width="6.5" fill="none" stroke-linecap="round"/>
      <path d="M130,100 Q172,68 252,80 Q312,90 332,126" stroke="url(#gVine)" stroke-width="5.5" fill="none" stroke-linecap="round"/>
      <!-- Lá trên dây leo (nhiều hơn, có gân) -->
      <g fill="#3f7d57">
        <ellipse cx="48" cy="390" rx="14" ry="8" transform="rotate(-30 48 390)"/>
        <ellipse cx="66" cy="306" rx="13" ry="7" transform="rotate(20 66 306)"/>
        <ellipse cx="58" cy="220" rx="12" ry="7" transform="rotate(-25 58 220)"/>
        <ellipse cx="72" cy="150" rx="11" ry="6" transform="rotate(28 72 150)"/>
        <ellipse cx="372" cy="390" rx="14" ry="8" transform="rotate(30 372 390)"/>
        <ellipse cx="354" cy="306" rx="13" ry="7" transform="rotate(-20 354 306)"/>
        <ellipse cx="362" cy="220" rx="12" ry="7" transform="rotate(25 362 220)"/>
        <ellipse cx="348" cy="150" rx="11" ry="6" transform="rotate(-28 348 150)"/>
        <ellipse cx="160" cy="86" rx="13" ry="7" transform="rotate(-15 160 86)"/>
        <ellipse cx="270" cy="84" rx="13" ry="7" transform="rotate(15 270 84)"/>
        <ellipse cx="210" cy="74" rx="12" ry="6" transform="rotate(0 210 74)"/>
      </g>
      <g stroke="#2d6a4f" stroke-width="0.6" opacity="0.5">
        <line x1="42" y1="384" x2="54" y2="396"/>
        <line x1="366" y1="384" x2="378" y2="396"/>
      </g>
    </svg>

    <!-- Hai cánh cửa gỗ (mở ra) -->
    <div class="gate-doors" id="gateDoors">
      <div class="gate-door gate-door-left">
        <div class="gp-bar b1"></div>
        <div class="gp-bar b2"></div>
        <div class="gp-bar b3"></div>
        <div class="gp-knob"></div>
        <div class="door-glow"></div>
      </div>
      <div class="gate-door gate-door-right">
        <div class="gp-bar b1"></div>
        <div class="gp-bar b2"></div>
        <div class="gp-bar b3"></div>
        <div class="gp-knob"></div>
        <div class="door-glow"></div>
      </div>
    </div>

    <!-- Ánh sáng ấm trong khung cửa -->
    <div class="gate-shine"></div>

    <!-- Hoa hồng leo chuyển động -->
    <div class="gate-flowers" aria-hidden="true">
      <div class="gflower gf1"></div><div class="gflower gf2"></div><div class="gflower gf3"></div>
      <div class="gflower gf4"></div><div class="gflower gf5"></div><div class="gflower gf6"></div>
      <div class="gflower gf7"></div><div class="gflower gf8"></div><div class="gflower gf9"></div>
      <div class="gflower gf10"></div><div class="gflower gf11"></div><div class="gflower gf12"></div>
    </div>
  </div>

  <!-- ===== Ánh chói phủ kín màn hình khi mở ===== -->
  <div class="light-burst" id="lightBurst" aria-hidden="true">
    <div class="burst-core"></div>
  </div>

  <!-- ===== Nội dung thiệp ===== -->
  <div class="op-content" id="opFrame">
    <h1 class="op-title">
      <%= data.event.name %>
      <small><%= data.event.nameShort %></small>
    </h1>
    <div class="op-divider"></div>
    <button class="btn-open" onclick="openCard()">Mở Thiệp</button>
    <div class="op-tap">hoặc chạm vào cổng</div>
  </div>
</div>

<!-- ============ HOA RƠI ============ -->
<div id="petals" aria-hidden="true"></div>

<!-- ============ NHẠC NỀN (PLACEHOLDER) ============ -->
<!-- 👉 Thêm nhạc: thả file vào public/music/ rồi set "musicFile" trong data/event.json -->
<% if (data.features.musicFile) { %>
<audio id="bgMusic" loop preload="none">
  <source src="<%= data.features.musicFile %>" type="audio/mpeg">
</audio>
<% } else { %>
<audio id="bgMusic" loop preload="none"></audio>
<% } %>
<button class="music-toggle paused" id="musicBtn" aria-label="Bật/tắt nhạc nền" title="Bật/tắt nhạc nền">
  <div class="bars"><span></span><span></span><span></span></div>
</button>

<!-- ============ NỘI DUNG ============ -->
<div class="wrapper">

  <!-- ---------- 1. LỜI MỜI ---------- -->
  <section id="invitation">
    <div class="container">
      <div class="invite-card reveal">
        <div class="invite-body">
          <div class="eyebrow">Lời ngỏ</div>
          <p class="invite-lead"><%= data.invitation.lead %></p>
          <% data.invitation.paragraphs.forEach(p => { %>
            <p class="invite-text"><%= p %></p>
          <% }); %>
          <div class="invite-signature">
            <span class="sig-name"><%= data.event.organizer %></span>
            <span class="sig-role">Trân trọng kính mời</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 2. THÔNG TIN LỄ ---------- -->
  <section id="details">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Thông tin buổi lễ</div>
        <h2 class="section-title">Chi tiết chương trình</h2>
        <p class="section-sub">Thời gian, địa điểm và những điều cần lưu ý</p>
      </div>
      <div class="detail-grid">
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div class="detail-label">Ngày</div>
          <div class="detail-value"><%= data.event.dateDisplay %></div>
          <div class="detail-note"><%= data.event.dateDetail %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
          </div>
          <div class="detail-label">Giờ</div>
          <div class="detail-value"><%= data.event.time %></div>
          <div class="detail-note"><%= data.event.timeNote %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </div>
          <div class="detail-label">Địa điểm</div>
          <div class="detail-value"><%= data.event.location %></div>
          <div class="detail-note"><%= data.event.locationNote %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
          </div>
          <div class="detail-label">Đơn vị</div>
          <div class="detail-value" style="font-size:clamp(1rem,2.2vw,1.2rem)"><%= data.event.organizerShort %></div>
          <div class="detail-note">Ban Tổ chức</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 3. ĐẾM NGƯỢC ---------- -->
  <section id="countdown">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow" style="color:var(--gold-light)">Đếm ngược</div>
        <h2 class="section-title">Còn lại</h2>
        <p class="section-sub">Cho đến ngày <%= data.event.name %> <%= data.event.nameShort %></p>
      </div>
      <div class="countdown-grid" id="countdownGrid">
        <div class="cd-box"><div class="cd-num" id="cdDays">--</div><div class="cd-unit">Ngày</div></div>
        <div class="cd-box"><div class="cd-num" id="cdHours">--</div><div class="cd-unit">Giờ</div></div>
        <div class="cd-box"><div class="cd-num" id="cdMinutes">--</div><div class="cd-unit">Phút</div></div>
        <div class="cd-box"><div class="cd-num" id="cdSeconds">--</div><div class="cd-unit">Giây</div></div>
      </div>
      <div class="cd-message" id="cdMessage"></div>
    </div>
  </section>

  <!-- ---------- 4. THƯ VIỆN ẢNH ---------- -->
  <section id="gallery">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Khoảnh khắc</div>
        <h2 class="section-title">Thư viện ảnh</h2>
        <p class="section-sub">Những hình ảnh đáng nhớ từ hành trình ACC</p>
      </div>
      <div class="gallery-grid">
        <% data.gallery.forEach((item, i) => { %>
          <div class="gallery-item reveal">
            <% if (item.image) { %>
              <img src="<%= item.image %>" alt="<%= item.caption %>" style="width:100%;height:100%;object-fit:cover;">
            <% } else { %>
              <div class="gallery-ph">
                <div class="ph-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
                <p>Ảnh <%= i + 1 %></p>
                <span><%= item.caption %></span>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ---------- 5. BẢN ĐỒ ---------- -->
  <section id="map">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Địa điểm</div>
        <h2 class="section-title">Bản đồ</h2>
        <p class="section-sub">Hướng dẫn đường đi đến <%= data.event.location %></p>
      </div>
      <div class="map-card reveal">
        <div class="map-embed">
          <div class="map-ph">
            <div class="ph-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </div>
            <p><%= data.event.location %></p>
            <span><%= data.event.mapAddress %></span>
          </div>
        </div>
        <div class="map-info">
          <div class="map-info-text">
            <h3><%= data.event.location %></h3>
            <p><%= data.event.mapAddress %></p>
          </div>
          <a href="<%= data.event.mapUrl %>" target="_blank" rel="noopener" class="btn-map">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20l-5.5-2.5a1 1 0 0 1-.5-.9V5.4a1 1 0 0 1 1.4-.9L9 6.5m0 13.5l6-3m-6 3V6.5m6 10.5l5.5-2.5a1 1 0 0 0 .5-.9V5.4a1 1 0 0 0-1.4-.9L15 6.5m0 10.5V6.5m0 0L9 6.5"/></svg>
            Xem bản đồ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 6. LỜI CẢM ƠN ---------- -->
  <section id="thanks">
    <div class="container">
      <div class="thanks-inner reveal">
        <div class="eyebrow">Lời cảm ơn</div>
        <div class="thanks-ornament">❦</div>
        <p class="thanks-quote"><%= data.thanks.quote %></p>
        <div class="thanks-sign"><%= data.thanks.signature %></div>
        <div class="thanks-role"><%= data.thanks.role %></div>
        <div class="thanks-ornament">✿</div>
      </div>
    </div>
  </section>

</div>

<footer>
  © 2026 · <strong><%= data.event.organizer %></strong> · Made with ❤️
</footer>

<script>
  window.EVENT_DATE = "<%= data.event.date %>";
</script>
<script src="/public/js/main.js?v=<%= typeof jsVersion !== 'undefined' ? jsVersion : Date.now() %>"></script>
</body>
</html>
