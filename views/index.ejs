    <div class="canopy canopy-right">
      <svg viewBox="0 0 300 220" preserveAspectRatio="xMaxYMin" aria-hidden="true">
        <g fill="#3f9460">
          <path d="M300,0 L0,0 Q40,30 100,40 Q150,50 180,90 Q220,140 260,150 Q285,155 300,140 Z"/>
