    <!-- Sương mù -->
    <div class="mist"></div>

    <!-- Chim bay -->
    <div class="birds" aria-hidden="true">
      <div class="bird b1"><svg viewBox="0 0 40 20"><path class="wing wl" d="M20,12 Q12,2 2,6 Q12,6 20,12"/><path class="wing wr" d="M20,12 Q28,2 38,6 Q28,6 20,12"/></svg></div>
