<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= data.event.name %> <%= data.event.nameShort %> — <%= data.event.organizer %></title>
<meta name="description" content="Thiệp mời <%= data.event.name %> <%= data.event.nameShort %> của <%= data.event.organizer %>">
<meta property="og:title" content="<%= data.event.name %> <%= data.event.nameShort %>">
<meta property="og:description" content="<%= data.event.dateDisplay %> · <%= data.event.time %> · <%= data.event.location %>">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/style.css?v=<%= typeof cssVersion !== 'undefined' ? cssVersion : Date.now() %>">
</head>
<body>

<!-- ============ MÀN HÌNH MỞ THIỆP: CỔNG RỪNG THẬT ============ -->
<div id="opening">
  <!-- Lớp nền rừng (parallax) -->
  <div class="bg-forest" id="bgForest"></div>
  <div class="bg-vignette"></div>
  <div class="bg-mist"></div>

  <!-- Lá bay + đom đóm -->
  <div class="leaves" aria-hidden="true"></div>
  <div class="fireflies" aria-hidden="true"></div>

  <!-- Sân khấu: cổng + sàn -->
  <div class="stage" id="stage">
    <!-- Sàn gạch phía trước -->
    <div class="floor"></div>

    <!-- Cổng thật -->
    <div class="gate3d" id="gate3d" title="Chạm để mở thiệp" role="button" tabindex="0" aria-label="Mở thiệp">
      <div class="gate-img" id="gateImg"></div>

      <!-- Ánh sáng phát ra từ cổng -->
      <div class="gate-shine"></div>

      <!-- Hai cánh cửa (lớp phủ mở ra) -->
      <div class="gate-doors" id="gateDoors">
        <div class="gate-door gate-door-left"><div class="door-glow"></div></div>
        <div class="gate-door gate-door-right"><div class="door-glow"></div></div>
      </div>

      <!-- Hoa leo chuyển động trên cổng -->
      <div class="gate-flowers" aria-hidden="true">
        <div class="gflower gf1"></div><div class="gflower gf2"></div><div class="gflower gf3"></div>
        <div class="gflower gf4"></div><div class="gflower gf5"></div><div class="gflower gf6"></div>
        <div class="gflower gf7"></div><div class="gflower gf8"></div><div class="gflower gf9"></div>
        <div class="gflower gf10"></div><div class="gflower gf11"></div><div class="gflower gf12"></div>
      </div>
    </div>
  </div>

  <!-- Ánh chói khi cổng mở -->
  <div class="light-burst" id="lightBurst" aria-hidden="true"></div>

  <!-- Nội dung thiệp -->
  <div class="op-content" id="opFrame">
    <div class="op-ornament">✦ ❦ ✦</div>
    <div class="op-small">Trân trọng kính mời</div>
    <h1 class="op-title">
      <%= data.event.name %>
      <small><%= data.event.nameShort %></small>
    </h1>
    <div class="op-divider"></div>
    <div class="op-date"><%= data.event.dateDisplay %></div>
    <button class="btn-open" onclick="openCard()">Mở Thiệp</button>
    <div class="op-tap">hoặc chạm vào cổng</div>
  </div>
</div>

<!-- ============ HOA RƠI ============ -->
<div id="petals" aria-hidden="true"></div>

<!-- ============ NHẠC NỀN (PLACEHOLDER) ============ -->
<!-- 👉 Thêm nhạc: thả file vào public/music/ rồi set "musicFile" trong data/event.json -->
<% if (data.features.musicFile) { %>
<audio id="bgMusic" loop preload="none">
  <source src="<%= data.features.musicFile %>" type="audio/mpeg">
</audio>
<% } else { %>
<audio id="bgMusic" loop preload="none"></audio>
<% } %>
<button class="music-toggle paused" id="musicBtn" aria-label="Bật/tắt nhạc nền" title="Bật/tắt nhạc nền">
  <div class="bars"><span></span><span></span><span></span></div>
</button>

<!-- ============ NỘI DUNG ============ -->
<div class="wrapper">

  <!-- ---------- 1. LỜI MỜI ---------- -->
  <section id="invitation">
    <div class="container">
      <div class="invite-card reveal">
        <div class="invite-body">
          <div class="eyebrow">Lời ngỏ</div>
          <p class="invite-lead"><%= data.invitation.lead %></p>
          <% data.invitation.paragraphs.forEach(p => { %>
            <p class="invite-text"><%= p %></p>
          <% }); %>
          <div class="invite-signature">
            <span class="sig-name"><%= data.event.organizer %></span>
            <span class="sig-role">Trân trọng kính mời</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 2. THÔNG TIN LỄ ---------- -->
  <section id="details">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Thông tin buổi lễ</div>
        <h2 class="section-title">Chi tiết chương trình</h2>
        <p class="section-sub">Thời gian, địa điểm và những điều cần lưu ý</p>
      </div>
      <div class="detail-grid">
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div class="detail-label">Ngày</div>
          <div class="detail-value"><%= data.event.dateDisplay %></div>
          <div class="detail-note"><%= data.event.dateDetail %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
          </div>
          <div class="detail-label">Giờ</div>
          <div class="detail-value"><%= data.event.time %></div>
          <div class="detail-note"><%= data.event.timeNote %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </div>
          <div class="detail-label">Địa điểm</div>
          <div class="detail-value"><%= data.event.location %></div>
          <div class="detail-note"><%= data.event.locationNote %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
          </div>
          <div class="detail-label">Đơn vị</div>
          <div class="detail-value" style="font-size:clamp(1rem,2.2vw,1.2rem)"><%= data.event.organizerShort %></div>
          <div class="detail-note">Ban Tổ chức</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 3. ĐẾM NGƯỢC ---------- -->
  <section id="countdown">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow" style="color:var(--gold-light)">Đếm ngược</div>
        <h2 class="section-title">Còn lại</h2>
        <p class="section-sub">Cho đến ngày <%= data.event.name %> <%= data.event.nameShort %></p>
      </div>
      <div class="countdown-grid" id="countdownGrid">
        <div class="cd-box"><div class="cd-num" id="cdDays">--</div><div class="cd-unit">Ngày</div></div>
        <div class="cd-box"><div class="cd-num" id="cdHours">--</div><div class="cd-unit">Giờ</div></div>
        <div class="cd-box"><div class="cd-num" id="cdMinutes">--</div><div class="cd-unit">Phút</div></div>
        <div class="cd-box"><div class="cd-num" id="cdSeconds">--</div><div class="cd-unit">Giây</div></div>
      </div>
      <div class="cd-message" id="cdMessage"></div>
    </div>
  </section>

  <!-- ---------- 4. THƯ VIỆN ẢNH ---------- -->
  <section id="gallery">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Khoảnh khắc</div>
        <h2 class="section-title">Thư viện ảnh</h2>
        <p class="section-sub">Những hình ảnh đáng nhớ từ hành trình ACC</p>
      </div>
      <div class="gallery-grid">
        <% data.gallery.forEach((item, i) => { %>
          <div class="gallery-item reveal">
            <% if (item.image) { %>
              <img src="<%= item.image %>" alt="<%= item.caption %>" style="width:100%;height:100%;object-fit:cover;">
            <% } else { %>
              <div class="gallery-ph">
                <div class="ph-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
                <p>Ảnh <%= i + 1 %></p>
                <span><%= item.caption %></span>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ---------- 5. BẢN ĐỒ ---------- -->
  <section id="map">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Địa điểm</div>
        <h2 class="section-title">Bản đồ</h2>
        <p class="section-sub">Hướng dẫn đường đi đến <%= data.event.location %></p>
      </div>
      <div class="map-card reveal">
        <div class="map-embed">
          <div class="map-ph">
            <div class="ph-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </div>
            <p><%= data.event.location %></p>
            <span><%= data.event.mapAddress %></span>
          </div>
        </div>
        <div class="map-info">
          <div class="map-info-text">
            <h3><%= data.event.location %></h3>
            <p><%= data.event.mapAddress %></p>
          </div>
          <a href="<%= data.event.mapUrl %>" target="_blank" rel="noopener" class="btn-map">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20l-5.5-2.5a1 1 0 0 1-.5-.9V5.4a1 1 0 0 1 1.4-.9L9 6.5m0 13.5l6-3m-6 3V6.5m6 10.5l5.5-2.5a1 1 0 0 0 .5-.9V5.4a1 1 0 0 0-1.4-.9L15 6.5m0 10.5V6.5m0 0L9 6.5"/></svg>
            Xem bản đồ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 6. LỜI CẢM ƠN ---------- -->
  <section id="thanks">
    <div class="container">
      <div class="thanks-inner reveal">
        <div class="eyebrow">Lời cảm ơn</div>
        <div class="thanks-ornament">❦</div>
        <p class="thanks-quote"><%= data.thanks.quote %></p>
        <div class="thanks-sign"><%= data.thanks.signature %></div>
        <div class="thanks-role"><%= data.thanks.role %></div>
        <div class="thanks-ornament">✿</div>
      </div>
    </div>
  </section>

</div>

<footer>
  © 2026 · <strong><%= data.event.organizer %></strong> · Made with ❤️
</footer>

<script>
  window.EVENT_DATE = "<%= data.event.date %>";
</script>
<script src="/public/js/main.js?v=<%= typeof jsVersion !== 'undefined' ? jsVersion : Date.now() %>"></script>
</body>
</html>
