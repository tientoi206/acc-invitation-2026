<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= data.event.name %> <%= data.event.nameShort %> — <%= data.event.organizer %></title>
<meta name="description" content="Thiệp mời <%= data.event.name %> <%= data.event.nameShort %> của <%= data.event.organizer %>">
<meta property="og:title" content="<%= data.event.name %> <%= data.event.nameShort %>">
<meta property="og:description" content="<%= data.event.dateDisplay %> · <%= data.event.time %> · <%= data.event.location %>">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Be+Vietnam+Pro:wght@300;400;500;600;700&family=Cormorant+Garamond:ital,wght@0,500;1,500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/public/css/style.css?v=<%= typeof cssVersion !== 'undefined' ? cssVersion : Date.now() %>">
</head>
<body>

<!-- ============ MÀN HÌNH MỞ THIỆP: CỔNG RỪNG (vẽ bằng code) ============ -->
<div id="opening">
<div class="world">
  <!-- ===== Nền trời + rừng nhiều lớp ===== -->
  <div class="scene">
    <div class="sky"></div>
    <div class="sun-glow"></div>

    <!-- Cây rừng lớp xa -->
    <div class="trees trees-far">
      <svg viewBox="0 0 1200 400" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="#9fd4aa"><circle cx="-35" cy="184" r="70"/><circle cx="54" cy="171" r="79"/><circle cx="140" cy="173" r="86"/><circle cx="229" cy="168" r="82"/><circle cx="320" cy="137" r="73"/><circle cx="400" cy="169" r="62"/><circle cx="482" cy="153" r="92"/><circle cx="568" cy="129" r="78"/><circle cx="654" cy="168" r="83"/><circle cx="726" cy="184" r="92"/><circle cx="803" cy="143" r="89"/><circle cx="884" cy="131" r="70"/><circle cx="970" cy="141" r="93"/><circle cx="1056" cy="171" r="91"/><circle cx="1124" cy="139" r="80"/><circle cx="1220" cy="150" r="67"/><rect y="170" width="1200" height="230"/></g>
        <g fill="#7cc08e"><circle cx="-8" cy="223" r="61"/><circle cx="48" cy="253" r="78"/><circle cx="126" cy="228" r="62"/><circle cx="192" cy="238" r="63"/><circle cx="267" cy="247" r="68"/><circle cx="337" cy="265" r="64"/><circle cx="429" cy="252" r="69"/><circle cx="491" cy="245" r="71"/><circle cx="577" cy="240" r="71"/><circle cx="629" cy="249" r="61"/><circle cx="704" cy="240" r="74"/><circle cx="794" cy="226" r="75"/><circle cx="843" cy="240" r="55"/><circle cx="916" cy="270" r="57"/><circle cx="1005" cy="227" r="64"/><circle cx="1077" cy="227" r="78"/><circle cx="1159" cy="265" r="77"/><circle cx="1232" cy="258" r="58"/><rect y="260" width="1200" height="140"/></g>
        <g fill="#5fae76"><circle cx="-35" cy="307" r="38"/><circle cx="24" cy="319" r="42"/><circle cx="105" cy="315" r="53"/><circle cx="149" cy="326" r="42"/><circle cx="212" cy="327" r="39"/><circle cx="275" cy="300" r="58"/><circle cx="338" cy="328" r="37"/><circle cx="405" cy="306" r="59"/><circle cx="454" cy="320" r="42"/><circle cx="503" cy="306" r="50"/><circle cx="557" cy="323" r="53"/><circle cx="636" cy="315" r="37"/><circle cx="677" cy="328" r="39"/><circle cx="753" cy="327" r="37"/><circle cx="818" cy="326" r="60"/><circle cx="879" cy="323" r="46"/><circle cx="917" cy="322" r="57"/><circle cx="981" cy="307" r="46"/><circle cx="1054" cy="317" r="44"/><circle cx="1106" cy="322" r="44"/><circle cx="1168" cy="313" r="41"/><circle cx="1214" cy="330" r="60"/><rect y="320" width="1200" height="80"/></g>
      </svg>
    </div>

    <!-- Cây rừng lớp gần -->
    <div class="trees trees-near">
      <svg viewBox="0 0 1200 460" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
        <g fill="#3f8f58"><circle cx="-36" cy="313" r="107"/><circle cx="21" cy="284" r="75"/><circle cx="100" cy="272" r="101"/><circle cx="183" cy="263" r="77"/><circle cx="238" cy="222" r="97"/><circle cx="961" cy="273" r="90"/><circle cx="1038" cy="247" r="100"/><circle cx="1086" cy="239" r="92"/><circle cx="1161" cy="294" r="82"/><circle cx="1232" cy="286" r="87"/></g>
