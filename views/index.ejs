            <radialGradient id="brassL" cx="35%" cy="30%" r="80%">
              <stop offset="0" stop-color="#fbe9a6"/>
              <stop offset=".55" stop-color="#d1a63c"/>
              <stop offset="1" stop-color="#7d5f17"/>
            </radialGradient>
          </defs>
          <g clip-path="url(#doorClipL)">
            <g filter="url(#woodGrainL)"><rect x="0" y="0" width="22" height="416" fill="#a9703f"/><rect x="22" y="0" width="22" height="416" fill="#9b6334"/><rect x="44" y="0" width="22" height="416" fill="#b27a47"/><rect x="66" y="0" width="22" height="416" fill="#a06838"/><rect x="88" y="0" width="22" height="416" fill="#965d2f"/></g>
            <line x1="22" y1="0" x2="22" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="23.4" y1="0" x2="23.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/><line x1="44" y1="0" x2="44" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="45.4" y1="0" x2="45.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/><line x1="66" y1="0" x2="66" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="67.4" y1="0" x2="67.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/><line x1="88" y1="0" x2="88" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="89.4" y1="0" x2="89.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/>
            <rect width="110" height="416" fill="url(#doorShadeL)"/>
            <path d="M8,110 A102,102 0 0 1 110,8" stroke="#2f2a26" stroke-width="5" fill="none"/>
            <path d="M8,110 A102,102 0 0 1 110,8" stroke="#6d655d" stroke-width="1" fill="none" transform="translate(-1,-1)"/>
            <path d="M0,144 H84 Q92,144 100,150 Q92,156 84,156 H0 Z" fill="url(#ironL)"/><circle cx="10" cy="150" r="2.4" fill="#57504a"/><circle cx="9.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="32" cy="150" r="2.4" fill="#57504a"/><circle cx="31.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="54" cy="150" r="2.4" fill="#57504a"/><circle cx="53.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="76" cy="150" r="2.4" fill="#57504a"/><circle cx="75.3" cy="149.2" r="0.9" fill="#a39a90"/><path d="M0,320 H84 Q92,320 100,326 Q92,332 84,332 H0 Z" fill="url(#ironL)"/><circle cx="10" cy="326" r="2.4" fill="#57504a"/><circle cx="9.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="32" cy="326" r="2.4" fill="#57504a"/><circle cx="31.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="54" cy="326" r="2.4" fill="#57504a"/><circle cx="53.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="76" cy="326" r="2.4" fill="#57504a"/><circle cx="75.3" cy="325.2" r="0.9" fill="#a39a90"/>
            <g transform="translate(94,233)">
              <circle r="6.5" fill="url(#brassL)" stroke="#6e5418" stroke-width=".8"/>
              <circle cy="9" r="9" fill="none" stroke="url(#brassL)" stroke-width="3"/>
              <circle cx="-1.6" cy="-1.8" r="1.6" fill="#fff4cc" opacity=".8"/>
            </g>
            <rect y="386" width="110" height="30" fill="url(#kickL)"/>
            <path d="M0,416 L0,110 A110,110 0 0 1 110,0 L110,416 Z" fill="none" stroke="#3a2210" stroke-width="3"/>
          </g>
        </svg>
      </div>
      <div class="gate-door gate-door-right">
        <svg viewBox="0 0 110 416" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <clipPath id="doorClipR"><path d="M0,416 L0,110 A110,110 0 0 1 110,0 L110,416 Z"/></clipPath>
            <filter id="woodGrainR" x="0" y="0" width="100%" height="100%">
              <feTurbulence type="fractalNoise" baseFrequency="0.02 0.42" numOctaves="3" seed="9" result="n"/>
              <feColorMatrix in="n" type="matrix" values="0 0 0 0 .28  0 0 0 0 .15  0 0 0 0 .06  0 0 0 .55 -.08" result="g"/>
              <feComposite in="g" in2="SourceGraphic" operator="in" result="gg"/>
              <feMerge><feMergeNode in="SourceGraphic"/><feMergeNode in="gg"/></feMerge>
            </filter>
            <linearGradient id="doorShadeR" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0" stop-color="#fff" stop-opacity=".14"/>
              <stop offset=".6" stop-color="#fff" stop-opacity="0"/>
              <stop offset="1" stop-color="#000" stop-opacity=".22"/>
            </linearGradient>
            <linearGradient id="kickR" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#000" stop-opacity="0"/>
              <stop offset="1" stop-color="#000" stop-opacity=".3"/>
            </linearGradient>
            <linearGradient id="ironR" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#5b544e"/>
              <stop offset=".45" stop-color="#2f2a26"/>
              <stop offset="1" stop-color="#1d1a17"/>
            </linearGradient>
            <radialGradient id="brassR" cx="35%" cy="30%" r="80%">
              <stop offset="0" stop-color="#fbe9a6"/>
              <stop offset=".55" stop-color="#d1a63c"/>
              <stop offset="1" stop-color="#7d5f17"/>
            </radialGradient>
          </defs><g transform="translate(110,0) scale(-1,1)">
          <g clip-path="url(#doorClipR)">
            <g filter="url(#woodGrainR)"><rect x="0" y="0" width="22" height="416" fill="#b27a47"/><rect x="22" y="0" width="22" height="416" fill="#a06838"/><rect x="44" y="0" width="22" height="416" fill="#965d2f"/><rect x="66" y="0" width="22" height="416" fill="#a9703f"/><rect x="88" y="0" width="22" height="416" fill="#9b6334"/></g>
            <line x1="22" y1="0" x2="22" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="23.4" y1="0" x2="23.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/><line x1="44" y1="0" x2="44" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="45.4" y1="0" x2="45.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/><line x1="66" y1="0" x2="66" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="67.4" y1="0" x2="67.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/><line x1="88" y1="0" x2="88" y2="416" stroke="#4a2c14" stroke-width="1.6"/><line x1="89.4" y1="0" x2="89.4" y2="416" stroke="#d29a62" stroke-width=".8" opacity=".45"/>
            <rect width="110" height="416" fill="url(#doorShadeR)"/>
            <path d="M8,110 A102,102 0 0 1 110,8" stroke="#2f2a26" stroke-width="5" fill="none"/>
            <path d="M8,110 A102,102 0 0 1 110,8" stroke="#6d655d" stroke-width="1" fill="none" transform="translate(-1,-1)"/>
            <path d="M0,144 H84 Q92,144 100,150 Q92,156 84,156 H0 Z" fill="url(#ironR)"/><circle cx="10" cy="150" r="2.4" fill="#57504a"/><circle cx="9.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="32" cy="150" r="2.4" fill="#57504a"/><circle cx="31.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="54" cy="150" r="2.4" fill="#57504a"/><circle cx="53.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="76" cy="150" r="2.4" fill="#57504a"/><circle cx="75.3" cy="149.2" r="0.9" fill="#a39a90"/><path d="M0,320 H84 Q92,320 100,326 Q92,332 84,332 H0 Z" fill="url(#ironR)"/><circle cx="10" cy="326" r="2.4" fill="#57504a"/><circle cx="9.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="32" cy="326" r="2.4" fill="#57504a"/><circle cx="31.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="54" cy="326" r="2.4" fill="#57504a"/><circle cx="53.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="76" cy="326" r="2.4" fill="#57504a"/><circle cx="75.3" cy="325.2" r="0.9" fill="#a39a90"/>
            <g transform="translate(94,233)">
              <circle r="6.5" fill="url(#brassR)" stroke="#6e5418" stroke-width=".8"/>
              <circle cy="9" r="9" fill="none" stroke="url(#brassR)" stroke-width="3"/>
              <circle cx="-1.6" cy="-1.8" r="1.6" fill="#fff4cc" opacity=".8"/>
            </g>
            <rect y="386" width="110" height="30" fill="url(#kickR)"/>
            <path d="M0,416 L0,110 A110,110 0 0 1 110,0 L110,416 Z" fill="none" stroke="#3a2210" stroke-width="3"/>
          </g></g>
        </svg>
      </div>
    </div>

    <!-- Ánh sáng lọt qua khe cửa -->
    <div class="gate-shine"></div>
  </div>

</div><!-- /.world -->

  <!-- ===== Ánh chói phủ kín màn hình khi mở ===== -->
  <div class="light-burst" id="lightBurst" aria-hidden="true"></div>

  <!-- ===== Nội dung thiệp ===== -->
  <div class="op-content" id="opFrame">
    <header class="op-head">
      <span class="op-spark s1">✦</span><span class="op-spark s2">✦</span><span class="op-spark s3">✧</span><span class="op-spark s4">✦</span>
      <h1 class="op-title"><%= data.event.name %></h1>
      <div class="op-sub"><span class="op-flourish"></span><span class="op-sub-text"><%= data.event.nameShort %></span><span class="op-flourish flip"></span></div>
    </header>
    <div class="op-actions">
      <button class="btn-open" onclick="openCard()">Mở Thiệp</button>
      <div class="op-tap">hoặc chạm vào cổng</div>
    </div>
  </div>
</div>

<!-- ============ HOA RƠI ============ -->
<div id="petals" aria-hidden="true"></div>

<!-- ============ NHẠC NỀN (PLACEHOLDER) ============ -->
<!-- 👉 Thêm nhạc: thả file vào public/music/ rồi set "musicFile" trong data/event.json -->
<% if (data.features.musicFile) { %>
<audio id="bgMusic" loop preload="none">
  <source src="<%= data.features.musicFile %>" type="audio/mpeg">
</audio>
<% } else { %>
<audio id="bgMusic" loop preload="none"></audio>
<% } %>
<button class="music-toggle paused" id="musicBtn" aria-label="Bật/tắt nhạc nền" title="Bật/tắt nhạc nền">
  <div class="bars"><span></span><span></span><span></span></div>
</button>

<!-- ============ NỘI DUNG ============ -->
<div class="wrapper">

  <!-- ---------- 1. LỜI MỜI ---------- -->
  <section id="invitation">
    <div class="container">
      <div class="invite-card reveal">
        <div class="invite-body">
          <div class="eyebrow">Lời ngỏ</div>
          <p class="invite-lead"><%= data.invitation.lead %></p>
          <% data.invitation.paragraphs.forEach(p => { %>
            <p class="invite-text"><%= p %></p>
          <% }); %>
          <div class="invite-signature">
            <span class="sig-name"><%= data.event.organizer %></span>
            <span class="sig-role">Trân trọng kính mời</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 2. THÔNG TIN LỄ ---------- -->
  <section id="details">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Thông tin buổi lễ</div>
        <h2 class="section-title">Chi tiết chương trình</h2>
        <p class="section-sub">Thời gian, địa điểm và những điều cần lưu ý</p>
      </div>
      <div class="detail-grid">
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          </div>
          <div class="detail-label">Ngày</div>
          <div class="detail-value"><%= data.event.dateDisplay %></div>
          <div class="detail-note"><%= data.event.dateDetail %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
          </div>
          <div class="detail-label">Giờ</div>
          <div class="detail-value"><%= data.event.time %></div>
          <div class="detail-note"><%= data.event.timeNote %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
          </div>
          <div class="detail-label">Địa điểm</div>
          <div class="detail-value"><%= data.event.location %></div>
          <div class="detail-note"><%= data.event.locationNote %></div>
        </div>
        <div class="detail-card reveal">
          <div class="detail-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2z"/><path d="M9 8h6M9 12h6M9 16h4"/></svg>
          </div>
          <div class="detail-label">Đơn vị</div>
          <div class="detail-value" style="font-size:clamp(1rem,2.2vw,1.2rem)"><%= data.event.organizerShort %></div>
          <div class="detail-note">Ban Tổ chức</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 3. ĐẾM NGƯỢC ---------- -->
  <section id="countdown">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow" style="color:var(--gold-light)">Đếm ngược</div>
        <h2 class="section-title">Còn lại</h2>
        <p class="section-sub">Cho đến ngày <%= data.event.name %> <%= data.event.nameShort %></p>
      </div>
      <div class="countdown-grid" id="countdownGrid">
        <div class="cd-box"><div class="cd-num" id="cdDays">--</div><div class="cd-unit">Ngày</div></div>
        <div class="cd-box"><div class="cd-num" id="cdHours">--</div><div class="cd-unit">Giờ</div></div>
        <div class="cd-box"><div class="cd-num" id="cdMinutes">--</div><div class="cd-unit">Phút</div></div>
        <div class="cd-box"><div class="cd-num" id="cdSeconds">--</div><div class="cd-unit">Giây</div></div>
      </div>
      <div class="cd-message" id="cdMessage"></div>
    </div>
  </section>

  <!-- ---------- 4. THƯ VIỆN ẢNH ---------- -->
  <section id="gallery">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Khoảnh khắc</div>
        <h2 class="section-title">Thư viện ảnh</h2>
        <p class="section-sub">Những hình ảnh đáng nhớ từ hành trình ACC</p>
      </div>
      <div class="gallery-grid">
        <% data.gallery.forEach((item, i) => { %>
          <div class="gallery-item reveal">
            <% if (item.image) { %>
              <img src="<%= item.image %>" alt="<%= item.caption %>" style="width:100%;height:100%;object-fit:cover;">
            <% } else { %>
              <div class="gallery-ph">
                <div class="ph-icon">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                </div>
                <p>Ảnh <%= i + 1 %></p>
                <span><%= item.caption %></span>
              </div>
            <% } %>
          </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- ---------- 5. BẢN ĐỒ ---------- -->
  <section id="map">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Địa điểm</div>
        <h2 class="section-title">Bản đồ</h2>
        <p class="section-sub">Hướng dẫn đường đi đến <%= data.event.location %></p>
      </div>
      <div class="map-card reveal">
        <div class="map-embed">
          <div class="map-ph">
            <div class="ph-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </div>
            <p><%= data.event.location %></p>
            <span><%= data.event.mapAddress %></span>
          </div>
        </div>
        <div class="map-info">
          <div class="map-info-text">
            <h3><%= data.event.location %></h3>
            <p><%= data.event.mapAddress %></p>
          </div>
          <a href="<%= data.event.mapUrl %>" target="_blank" rel="noopener" class="btn-map">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20l-5.5-2.5a1 1 0 0 1-.5-.9V5.4a1 1 0 0 1 1.4-.9L9 6.5m0 13.5l6-3m-6 3V6.5m6 10.5l5.5-2.5a1 1 0 0 0 .5-.9V5.4a1 1 0 0 0-1.4-.9L15 6.5m0 10.5V6.5m0 0L9 6.5"/></svg>
            Xem bản đồ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 6. LỜI CẢM ƠN ---------- -->
  <section id="thanks">
    <div class="container">
      <div class="thanks-inner reveal">
        <div class="eyebrow">Lời cảm ơn</div>
        <div class="thanks-ornament">❦</div>
        <p class="thanks-quote"><%= data.thanks.quote %></p>
        <div class="thanks-sign"><%= data.thanks.signature %></div>
        <div class="thanks-role"><%= data.thanks.role %></div>
        <div class="thanks-ornament">✿</div>
      </div>
    </div>
  </section>

</div>

<footer>
  © 2026 · <strong><%= data.event.organizer %></strong> · Made with ❤️
</footer>

<script>
  window.EVENT_DATE = "<%= data.event.date %>";
</script>
<script src="/public/js/main.js?v=<%= typeof jsVersion !== 'undefined' ? jsVersion : Date.now() %>"></script>
</body>
</html>
