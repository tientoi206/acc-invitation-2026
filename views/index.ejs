              <feColorMatrix in="n" type="matrix" values="0 0 0 0 .28  0 0 0 0 .15  0 0 0 0 .06  0 0 0 .55 -.08" result="g"/>
              <feComposite in="g" in2="SourceGraphic" operator="in" result="gg"/>
