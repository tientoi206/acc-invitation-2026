    <div class="leaves" aria-hidden="true"></div>
    <div class="fireflies" aria-hidden="true"></div>
  </div>

  <!-- ===== Thảm cỏ + lối đi lát đá (SVG phối cảnh) ===== -->
  <div class="floor">
    <svg viewBox="0 0 1200 300" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
      <defs>
        <linearGradient id="lawnGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#5fae76"/>
          <stop offset=".4" stop-color="#6dbb80"/>
          <stop offset="1" stop-color="#4f9f63"/>
        </linearGradient>
        <linearGradient id="pathGrad" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f7f0de"/>
          <stop offset="1" stop-color="#e2d4b2"/>
        </linearGradient>
        <linearGradient id="floorFade" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#5fae76" stop-opacity="0.9"/>
          <stop offset="0.25" stop-color="#5fae76" stop-opacity="0"/>
        </linearGradient>
      </defs>
      <rect width="1200" height="300" fill="url(#lawnGrad)"/>
      <rect width="1200" height="300" fill="url(#floorFade)"/>
    </svg>
  </div>

  <!-- ===== Tia nắng toả ra sau cổng ===== -->
  <div class="gate-rays" aria-hidden="true"></div>

