    <!-- Ánh sáng lọt qua khe cửa -->
    <div class="gate-shine"></div>
  </div>

</div><!-- /.world -->

  <!-- ===== Ánh chói phủ kín màn hình khi mở ===== -->
  <div class="light-burst" id="lightBurst" aria-hidden="true"></div>

  <!-- ===== Nội dung thiệp ===== -->
  <div class="op-content" id="opFrame">
    <header class="op-head">
      <span class="op-spark s1">✦</span><span class="op-spark s2">✦</span><span class="op-spark s3">✧</span><span class="op-spark s4">✦</span>
      <h1 class="op-title"><%= data.event.name %></h1>
      <div class="op-sub"><span class="op-flourish"></span><span class="op-sub-text"><%= data.event.nameShort %></span><span class="op-flourish flip"></span></div>
    </header>
    <div class="op-actions">
      <button class="btn-open" onclick="openCard()">Mở Thiệp</button>
      <div class="op-tap">hoặc chạm vào cổng</div>
    </div>
  </div>
</div>

<!-- ============ HOA RƠI ============ -->
<div id="petals" aria-hidden="true"></div>

<!-- ============ NHẠC NỀN ============ -->
<!-- 👉 Thêm nhạc: thả 1 file .mp3 vào public/music/ là xong (server tự nhận).
     Phát khi bấm mở cổng, lặp suốt lúc xem thiệp. Không có file thì ẩn nút nhạc. -->
<% if (typeof musicSrc !== 'undefined' && musicSrc) { %>
<audio id="bgMusic" loop preload="auto" playsinline src="<%= musicSrc %>" data-start="<%= Number(data.features.musicStart) || 0 %>"></audio>
<button class="music-toggle paused" id="musicBtn" aria-label="Bật/tắt nhạc nền" title="Bật/tắt nhạc nền">
  <div class="bars"><span></span><span></span><span></span></div>
</button>
<% } %>

<!-- ============ NỘI DUNG ============ -->
<div class="wrapper">

  <!-- ---------- 1. LỜI MỜI ---------- -->
  <section id="invitation">
    <div class="container">
      <div class="invite-card reveal">
        <div class="invite-body">
          <div class="eyebrow">Lời ngỏ</div>
          <p class="invite-lead"><%= data.invitation.lead %></p>
          <% data.invitation.paragraphs.forEach(p => { %>
            <p class="invite-text"><%= p %></p>
          <% }); %>
          <div class="invite-signature">
            <span class="sig-name"><%= data.event.organizer %></span>
            <span class="sig-role">Trân trọng kính mời</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 2. CHI TIẾT CHƯƠNG TRÌNH ---------- -->
  <%
    // Tách ngày/tháng/năm từ chuỗi ISO (giữ đúng giờ VN, không phụ thuộc múi giờ server)
    const ev = data.event;
    const dY = ev.date.slice(0, 4), dM = String(+ev.date.slice(5, 7)), dD = ev.date.slice(8, 10);
    const weekday = (ev.dateDisplay || '').split('·')[0].trim();
    // Link "Lưu vào lịch" (Google Calendar) — giờ UTC
    const gcal = (dt) => dt.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
    const startAt = new Date(ev.date);
    const endAt = new Date(startAt.getTime() + (Number(ev.durationHours) || 3) * 3600000);
    const calUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE'
      + '&text=' + encodeURIComponent(ev.name + ' ' + ev.nameShort)
      + '&dates=' + gcal(startAt) + '/' + gcal(endAt)
      + '&location=' + encodeURIComponent(ev.location + (ev.mapAddress ? ' — ' + ev.mapAddress : ''))
      + '&details=' + encodeURIComponent('Thiệp mời ' + ev.name + ' ' + ev.nameShort + ' — ' + ev.organizer);
  %>
  <%
    // Lịch tháng (tuần bắt đầu từ Thứ 2) để khoanh ngày diễn ra buổi lễ
    const yN = +dY, mN = +dM, dayN = +dD;
    const firstDow = (new Date(Date.UTC(yN, mN - 1, 1)).getUTCDay() + 6) % 7;
    const daysInMonth = new Date(Date.UTC(yN, mN, 0)).getUTCDate();
    const cells = [];
    for (let i = 0; i < firstDow; i++) cells.push('');
    for (let d = 1; d <= daysInMonth; d++) cells.push(d);
    while (cells.length % 7) cells.push('');
  %>
  <section id="details">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Thông tin buổi lễ</div>
        <h2 class="section-title">Chi tiết chương trình</h2>
        <p class="section-sub">Rất mong được đón tiếp Quý vị</p>
      </div>

      <div class="when-wrap reveal">
        <!-- Tờ lịch -->
        <div class="cal-card">
          <div class="cal-rings" aria-hidden="true"><span></span><span></span></div>
          <div class="cal-head">
            <div class="cal-month">Tháng <%= mN %></div>
            <div class="cal-year"><%= yN %></div>
          </div>
          <div class="cal-grid" role="grid" aria-label="Lịch tháng <%= mN %> năm <%= yN %>">
            <% ['T2','T3','T4','T5','T6','T7','CN'].forEach((w, i) => { %>
              <div class="cal-dow<%= i === 6 ? ' sun' : '' %>"><%= w %></div>
            <% }); %>
            <% cells.forEach((c, i) => { %>
              <div class="cal-day<%= c === dayN ? ' is-event' : '' %><%= i % 7 === 6 ? ' sun' : '' %><%= c === '' ? ' empty' : '' %>">
                <% if (c === dayN) { %>
                  <span class="cal-ring" aria-hidden="true"></span>
                  <span class="cal-num"><%= c %></span>
                  <svg class="cal-heart" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.7 4.5c2.1 0 3.6 1.2 4.3 2.5.7-1.3 2.2-2.5 4.3-2.5 3.7 0 5.8 3.9 4.3 7.3C19.5 16.4 12 21 12 21z"/></svg>
                <% } else { %><%= c %><% } %>
              </div>
            <% }); %>
          </div>
          <div class="cal-foot"><%= weekday %><% if (ev.dateDetail) { %> · <em><%= ev.dateDetail %></em><% } %></div>
        </div>

        <!-- Thời gian & địa điểm -->
        <div class="when-info">
          <div class="when-item">
            <div class="when-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg>
            </div>
            <div>
              <div class="when-label">Thời gian</div>
              <div class="when-value"><span class="when-big"><%= ev.time %></span> sáng <%= weekday %></div>
              <div class="when-note">Ngày <%= dD %> tháng <%= mN %> năm <%= yN %><% if (ev.timeNote) { %> · <%= ev.timeNote %><% } %></div>
            </div>
          </div>
          <div class="when-line" aria-hidden="true"></div>
          <div class="when-item">
            <div class="when-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </div>
            <div>
              <div class="when-label">Địa điểm</div>
              <div class="when-value when-place"><%= ev.location %></div>
              <% if (ev.mapAddress) { %><div class="when-note"><%= ev.mapAddress %></div><% } %>
            </div>
          </div>
          <div class="when-actions">
            <a class="btn-when solid" href="<%= calUrl %>" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/><path d="M12 14v4M10 16h4"/></svg>
              Lưu vào lịch
            </a>
            <a class="btn-when" href="<%= ev.mapUrl %>" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
              Chỉ đường
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 3. LỊCH TRÌNH BUỔI LỄ (sửa nội dung trong data/event.json → "schedule") ---------- -->
  <% if (Array.isArray(data.schedule) && data.schedule.length) { %>
  <section id="schedule">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Timeline</div>
        <h2 class="section-title">Lịch trình buổi lễ</h2>
        <p class="section-sub">Các phần chính của chương trình trong ngày</p>
      </div>
      <ol class="timeline">
        <% data.schedule.forEach((s, i) => { %>
        <li class="tl-item reveal <%= i % 2 ? 'right' : 'left' %>">
          <div class="tl-dot"><span><%= i + 1 %></span></div>
          <div class="tl-card">
            <div class="tl-time"><%= s.time %></div>
            <h3 class="tl-title"><%= s.title %></h3>
            <% if (s.desc) { %><p class="tl-desc"><%= s.desc %></p><% } %>
          </div>
        </li>
        <% }); %>
      </ol>
    </div>
  </section>
  <% } %>

  <!-- ---------- 4. ALBUM ẢNH (thả ảnh vào public/images/gallery/ là tự nhận) ---------- -->
  <% const photos = (typeof gallery !== 'undefined' ? gallery : data.gallery) || []; %>
  <section id="gallery">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Khoảnh khắc</div>
        <h2 class="section-title">Album ảnh</h2>
        <p class="section-sub">Những hình ảnh đáng nhớ từ hành trình ACC</p>
      </div>

      <!-- Album dạng coverflow 3D: ảnh giữa nổi bật, hai bên nghiêng lùi -->
      <div class="cf reveal pre" id="gallerySlider">
        <!-- số thứ tự cỡ lớn phía sau ảnh giữa -->
        <div class="cf-bignum" aria-hidden="true">01</div>
        <div class="cf-stage" tabindex="0" aria-label="Album ảnh — vuốt hoặc dùng nút để xem tiếp, bấm ảnh giữa để xem lớn">
          <% photos.forEach((item, i) => { %>
          <figure class="cf-slide" data-i="<%= i %>">
            <div class="cf-frame">
              <% if (item.image) { %>
                <img src="<%= item.image %>" alt="<%= item.caption || ('Ảnh ' + (i + 1)) %>" loading="lazy" draggable="false">
              <% } else { %>
                <div class="gallery-ph">
                  <div class="ph-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-5-5L5 21"/></svg>
                  </div>
                  <p>Ảnh <%= i + 1 %></p>
                  <span><%= item.caption %></span>
                </div>
              <% } %>
              <span class="cf-glare" aria-hidden="true"></span>
              <span class="cf-shine" aria-hidden="true"></span>
              <span class="cf-corner tl" aria-hidden="true"></span><span class="cf-corner tr" aria-hidden="true"></span>
              <span class="cf-corner bl" aria-hidden="true"></span><span class="cf-corner br" aria-hidden="true"></span>
              <span class="cf-zoom" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5M11 8v6M8 11h6"/></svg>
              </span>
              <% if (item.caption && item.image) { %><figcaption><%= item.caption %></figcaption><% } %>
            </div>
          </figure>
          <% }); %>
        </div>
        <button class="cf-btn prev" type="button" aria-label="Ảnh trước">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <button class="cf-btn next" type="button" aria-label="Ảnh tiếp theo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <!-- thanh thời gian tự chuyển ảnh -->
        <div class="cf-progress" aria-hidden="true"><span></span></div>
        <div class="cf-foot">
          <button class="cf-play" type="button" aria-label="Tạm dừng tự chuyển ảnh" aria-pressed="false">
            <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2"/><rect x="13.9" y="5" width="3.6" height="14" rx="1.2"/></svg>
            <svg class="i-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
          </button>
          <div class="cf-count"><span class="car-cur">01</span><i></i><span><%= String(photos.length).padStart(2, '0') %></span></div>
          <div class="cf-thumbs" role="tablist" aria-label="Chọn ảnh"></div>
        </div>
      </div>

      <!-- Xem ảnh toàn màn hình -->
      <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Xem ảnh" hidden>
        <div class="lb-bg" aria-hidden="true"></div>
        <div class="lb-top">
          <div class="lb-count"></div>
          <div class="lb-tools">
            <button class="lb-tool lb-slideshow" type="button" aria-label="Trình chiếu tự động" aria-pressed="false">
              <svg class="i-play" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13a1 1 0 0 0 1.5.86l10.4-6.5a1 1 0 0 0 0-1.72L9.5 4.64A1 1 0 0 0 8 5.5z"/></svg>
              <svg class="i-pause" viewBox="0 0 24 24" fill="currentColor"><rect x="6.5" y="5" width="3.6" height="14" rx="1.2"/><rect x="13.9" y="5" width="3.6" height="14" rx="1.2"/></svg>
            </button>
            <button class="lb-tool lb-full" type="button" aria-label="Toàn màn hình">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"/></svg>
            </button>
            <button class="lb-tool lb-close" type="button" aria-label="Đóng">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
        </div>
        <div class="lb-bar" aria-hidden="true"><span></span></div>
        <button class="lb-btn prev" type="button" aria-label="Ảnh trước">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <figure class="lb-figure">
          <div class="lb-media"></div>
          <figcaption class="lb-cap"></figcaption>
        </figure>
        <button class="lb-btn next" type="button" aria-label="Ảnh tiếp theo">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18l6-6-6-6"/></svg>
        </button>
        <div class="lb-thumbs" role="tablist" aria-label="Chọn ảnh"></div>
      </div>
    </div>
  </section>

  <!-- ---------- 5. ĐẾM NGƯỢC ---------- -->
  <section id="countdown">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow" style="color:var(--gold-light)">Đếm ngược</div>
        <h2 class="section-title">Còn lại</h2>
        <p class="section-sub">Cho đến ngày <%= data.event.name %> <%= data.event.nameShort %></p>
      </div>
      <div class="countdown-grid" id="countdownGrid" role="timer" aria-label="Thời gian còn lại">
        <div class="cd-box">
          <div class="flip" id="cdDays" aria-live="off">
            <span class="flip-top">--</span><span class="flip-bottom">--</span>
            <span class="flip-leaf-top">--</span><span class="flip-leaf-bottom">--</span>
          </div>
          <div class="cd-unit">Ngày</div>
        </div>
        <div class="cd-colon" aria-hidden="true">:</div>
        <div class="cd-box">
          <div class="flip" id="cdHours" aria-live="off">
            <span class="flip-top">--</span><span class="flip-bottom">--</span>
            <span class="flip-leaf-top">--</span><span class="flip-leaf-bottom">--</span>
          </div>
          <div class="cd-unit">Giờ</div>
        </div>
        <div class="cd-colon" aria-hidden="true">:</div>
        <div class="cd-box">
          <div class="flip" id="cdMinutes" aria-live="off">
            <span class="flip-top">--</span><span class="flip-bottom">--</span>
            <span class="flip-leaf-top">--</span><span class="flip-leaf-bottom">--</span>
          </div>
          <div class="cd-unit">Phút</div>
        </div>
        <div class="cd-colon" aria-hidden="true">:</div>
        <div class="cd-box">
          <div class="flip" id="cdSeconds" aria-live="off">
            <span class="flip-top">--</span><span class="flip-bottom">--</span>
            <span class="flip-leaf-top">--</span><span class="flip-leaf-bottom">--</span>
          </div>
          <div class="cd-unit">Giây</div>
        </div>
      </div>
      <div class="cd-date"><span>✦</span> <%= data.event.dateDisplay %> · <%= data.event.time %> <span>✦</span></div>
      <div class="cd-message" id="cdMessage"></div>
    </div>
  </section>

  <!-- ---------- 6. ĐĂNG KÝ THAM DỰ (xem danh sách ở /quan-ly) ---------- -->
  <section id="rsvp">
    <div class="container">
      <div class="rsvp-card reveal">
        <div class="rsvp-intro">
          <div class="eyebrow">Xác nhận tham dự</div>
          <h2 class="section-title">Đăng ký tham dự</h2>
          <p class="rsvp-lead">Nếu Quý vị có thể đến chung vui, xin để lại vài thông tin để Ban Tổ chức chuẩn bị chu đáo và tiện liên lạc.</p>
          <ul class="rsvp-points">
            <li><span>✦</span> <%= data.event.dateDisplay %> · <%= data.event.time %></li>
            <li><span>✦</span> <%= data.event.location %></li>
            <li><span>✦</span> Gửi lại cùng số Zalo để sửa thông tin</li>
          </ul>
        </div>

        <form class="rsvp-form" id="rsvpForm" novalidate>
          <div class="field">
            <label for="rsvpName">Họ và tên <b>*</b></label>
            <input id="rsvpName" name="name" type="text" autocomplete="name" maxlength="80" placeholder="Nguyễn Văn A" required>
            <small class="err" data-for="name"></small>
          </div>
          <div class="field">
            <label for="rsvpZalo">Số Zalo <b>*</b></label>
            <input id="rsvpZalo" name="zalo" type="tel" inputmode="tel" autocomplete="tel" maxlength="20" placeholder="0912 345 678" required>
            <small class="err" data-for="zalo"></small>
          </div>
          <div class="field">
            <label for="rsvpFb">Facebook</label>
            <input id="rsvpFb" name="facebook" type="text" maxlength="200" placeholder="Tên Facebook hoặc link (không bắt buộc)">
            <small class="err" data-for="facebook"></small>
          </div>
          <!-- ô bẫy chống spam, người dùng không thấy -->
          <input class="hp" name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true">
          <button class="btn-rsvp" type="submit">
            <span class="txt">Gửi đăng ký</span>
            <span class="spin" aria-hidden="true"></span>
          </button>
          <p class="rsvp-msg" role="status" aria-live="polite"></p>
        </form>

        <div class="rsvp-done" id="rsvpDone" hidden>
          <div class="done-icon" aria-hidden="true">
            <svg viewBox="0 0 52 52"><circle cx="26" cy="26" r="24" fill="none"/><path fill="none" d="M15 27l7 7 15-16"/></svg>
          </div>
          <h3>Cảm ơn <span class="done-name"></span>!</h3>
          <p>Ban Tổ chức đã nhận được đăng ký của bạn. Hẹn gặp bạn tại <%= data.event.name %> <%= data.event.nameShort %>.</p>
          <button type="button" class="btn-edit" id="rsvpEdit">Sửa thông tin</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 7. BẢN ĐỒ ---------- -->
  <section id="map">
    <div class="container">
      <div class="center reveal">
        <div class="eyebrow">Địa điểm</div>
        <h2 class="section-title">Bản đồ</h2>
        <p class="section-sub">Hướng dẫn đường đi đến <%= data.event.location %></p>
      </div>
      <div class="map-card reveal">
        <div class="map-embed">
          <% if (data.event.mapEmbed) { %>
          <iframe src="<%= data.event.mapEmbed %>" title="Bản đồ đến <%= data.event.location %>" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
          <% } else { %>
          <div class="map-ph">
            <div class="ph-icon">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-6.4-7-11a7 7 0 0 1 14 0c0 4.6-7 11-7 11z"/><circle cx="12" cy="10" r="2.6"/></svg>
            </div>
            <p><%= data.event.location %></p>
            <span><%= data.event.mapAddress %></span>
          </div>
          <% } %>
        </div>
        <div class="map-info">
          <div class="map-info-text">
            <h3><%= data.event.location %></h3>
            <p><%= data.event.mapAddress %><% if (data.event.mapPlusCode) { %> · <span class="map-code"><%= data.event.mapPlusCode %></span><% } %></p>
          </div>
          <a href="<%= data.event.mapUrl %>" target="_blank" rel="noopener" class="btn-map">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 20l-5.5-2.5a1 1 0 0 1-.5-.9V5.4a1 1 0 0 1 1.4-.9L9 6.5m0 13.5l6-3m-6 3V6.5m6 10.5l5.5-2.5a1 1 0 0 0 .5-.9V5.4a1 1 0 0 0-1.4-.9L15 6.5m0 10.5V6.5m0 0L9 6.5"/></svg>
            Xem bản đồ
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ---------- 8. LỜI CẢM ƠN ---------- -->
  <section id="thanks">
    <div class="container">
      <div class="thanks-inner reveal">
        <div class="eyebrow">Lời cảm ơn</div>
        <div class="thanks-ornament">❦</div>
        <p class="thanks-quote"><%= data.thanks.quote %></p>
        <div class="thanks-sign"><%= data.thanks.signature %></div>
        <div class="thanks-role"><%= data.thanks.role %></div>
        <div class="thanks-ornament">✿</div>
      </div>
    </div>
  </section>

</div>

<footer>
  © 2026 · <strong><%= data.event.organizer %></strong> · Made with ❤️
</footer>

<script>
  window.EVENT_DATE = "<%= data.event.date %>";
</script>
<script src="/public/js/main.js?v=<%= typeof jsVersion !== 'undefined' ? jsVersion : Date.now() %>"></script>
</body>
</html>
