            <linearGradient id="kickL" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#000" stop-opacity="0"/>
              <stop offset="1" stop-color="#000" stop-opacity=".3"/>
            </linearGradient>
            <linearGradient id="ironL" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0" stop-color="#5b544e"/>
              <stop offset=".45" stop-color="#2f2a26"/>
              <stop offset="1" stop-color="#1d1a17"/>
