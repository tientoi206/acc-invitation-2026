            <rect width="110" height="416" fill="url(#doorShadeR)"/>
            <path d="M8,110 A102,102 0 0 1 110,8" stroke="#2f2a26" stroke-width="5" fill="none"/>
            <path d="M8,110 A102,102 0 0 1 110,8" stroke="#6d655d" stroke-width="1" fill="none" transform="translate(-1,-1)"/>
            <path d="M0,144 H84 Q92,144 100,150 Q92,156 84,156 H0 Z" fill="url(#ironR)"/><circle cx="10" cy="150" r="2.4" fill="#57504a"/><circle cx="9.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="32" cy="150" r="2.4" fill="#57504a"/><circle cx="31.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="54" cy="150" r="2.4" fill="#57504a"/><circle cx="53.3" cy="149.2" r="0.9" fill="#a39a90"/><circle cx="76" cy="150" r="2.4" fill="#57504a"/><circle cx="75.3" cy="149.2" r="0.9" fill="#a39a90"/><path d="M0,320 H84 Q92,320 100,326 Q92,332 84,332 H0 Z" fill="url(#ironR)"/><circle cx="10" cy="326" r="2.4" fill="#57504a"/><circle cx="9.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="32" cy="326" r="2.4" fill="#57504a"/><circle cx="31.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="54" cy="326" r="2.4" fill="#57504a"/><circle cx="53.3" cy="325.2" r="0.9" fill="#a39a90"/><circle cx="76" cy="326" r="2.4" fill="#57504a"/><circle cx="75.3" cy="325.2" r="0.9" fill="#a39a90"/>
            <g transform="translate(94,233)">
              <circle r="6.5" fill="url(#brassR)" stroke="#6e5418" stroke-width=".8"/>
              <circle cy="9" r="9" fill="none" stroke="url(#brassR)" stroke-width="3"/>
              <circle cx="-1.6" cy="-1.8" r="1.6" fill="#fff4cc" opacity=".8"/>
            </g>
            <rect y="386" width="110" height="30" fill="url(#kickR)"/>
